<?xml version="1.0" encoding="utf-8"?>
<!--
   Android-Auto-Backup (bis API 30; ab 31 gilt data_extraction_rules.xml).

   Ausgeschlossen ist genau das, was ein wiederhergestelltes Backup kaputt machen würde
   (Sync-Plan E14):

   - datastore/geraet.preferences_pb — Geräte-ID und Nummernband. Ein Backup auf ein zweites
     Gerät klonte sonst die Identität: zwei Geräte mit derselben ID im selben Nummernband,
     deren ID-Kollisionen nicht einmal erkennbar wären (Ablauf 26).
   - aufnahmen/ und ghost/ — Videos und Keypoint-Spuren. Die sprengen die Backup-Quota und
     gehören ohnehin in den Geräte-Abgleich, nicht in die Cloud-Sicherung.

   Alles andere (Datenbank, Einstellungen) wird weiter gesichert.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/geraet.preferences_pb" />
    <exclude domain="file" path="aufnahmen" />
    <exclude domain="file" path="ghost" />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<!--
   Ab API 31: getrennte Regeln für Cloud-Backup und Gerät-zu-Gerät-Übertragung.
   Begründung der Ausschlüsse siehe backup_rules.xml (Sync-Plan E14).

   Die Ausschlüsse gelten für BEIDE Wege — auch bei der direkten Geräteübertragung darf die
   Geräte-Identität nicht mitwandern, sonst stehen hinterher zwei Geräte im selben Band.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/geraet.preferences_pb" />
        <exclude domain="file" path="aufnahmen" />
        <exclude domain="file" path="ghost" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/geraet.preferences_pb" />
        <exclude domain="file" path="aufnahmen" />
        <exclude domain="file" path="ghost" />
    </device-transfer>
</data-extraction-rules>

<?xml version="1.0" encoding="utf-8"?>
<!--
  App-Widget-Metadaten für das Glance-BoulderWidget (7.4c).
  initialLayout nutzt das Standard-Ladelayout aus der Glance-Library.
  updatePeriodMillis = 30 min (Minimum, das das Framework respektiert).
-->
<!--
  targetCellWidth/-Height gelten erst ab Android 12 und sind dort der vorgesehene Weg, eine
  Widget-Groesse anzugeben. Aeltere Fassungen ignorieren sie stillschweigend und richten sich
  nach minWidth/minHeight, die deshalb weiterhin danebenstehen. Beides gehoert zusammen; ein
  eigener xml-v31-Ordner waere dieselbe Datei zweimal.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedAttribute"
    android:description="@string/widget_description"
    android:initialLayout="@layout/glance_default_loading_layout"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />

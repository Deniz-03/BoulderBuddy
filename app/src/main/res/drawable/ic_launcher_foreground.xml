<?xml version="1.0" encoding="utf-8"?>
<!--
  Boulder mit drei Griffen, als Silhouette gezeichnet.

  Zwei Bedingungen bestimmen die Form, nicht der Geschmack:

  1. `monochrome` im adaptive-icon zeigt genau dieses Drawable, nur einfarbig getönt
     (themed icons ab Android 13). Die Griffe sind deshalb als Löcher gestanzt
     (`fillType="evenOdd"`), nicht als zweite Farbe — eine zweite Farbe wäre im
     Themed-Icon verschwunden und der Boulder wäre ein Klumpen.
  2. Der Launcher maskiert das 108er-Viewport auf einen Kreis mit 66 dp Durchmesser.
     Alle Punkte liegen darum innerhalb von 33 vom Mittelpunkt (54,54) — der
     äußerste (30,74) bei 31,2.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#262521"
        android:fillType="evenOdd"
        android:pathData="M30,74 L30,48 L42,30 L60,27 L76,40 L81,60 L78,74 Z
                          M39,58 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z
                          M52,47 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0 Z
                          M64.5,55 a4.5,4.5 0 1,0 9,0 a4.5,4.5 0 1,0 -9,0 Z" />
</vector>

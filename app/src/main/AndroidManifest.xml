<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Gym-Näherungs-Push: Standort-Button im Gym-Editor (Foreground) — M1. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Gym-Näherungs-Push: Geofencing bei geschlossener App + Re-Register nach Boot — M2.
         ACCESS_BACKGROUND_LOCATION ist ab API 29 separat, ab API 30 nur via Settings-Flow. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Gym-Näherungs-Push: "Session starten?"-Notification (Runtime-Permission ab API 33) — M4. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".BoulderBuddyApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BoulderBuddy">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.BoulderBuddy">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Homescreen-Widget (Phase 7.4c): aktive Session / Tops / Schnellstart. -->
        <receiver
            android:name="com.boulderbuddy.widget.BoulderWidgetReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/boulder_widget_info" />
        </receiver>

        <!-- Gym-Näherungs-Push (M2): Geofence-Transitions (DWELL) vom System. -->
        <receiver
            android:name="com.boulderbuddy.proximity.GeofenceBroadcastReceiver"
            android:exported="false" />

        <!-- Gym-Näherungs-Push (M2): Geofences überleben keinen Reboot → neu registrieren.
             exported=false reicht — BOOT_COMPLETED ist ein geschützter System-Broadcast. -->
        <receiver
            android:name="com.boulderbuddy.proximity.GeofenceBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Empfängt fertige Hangboard-Durchläufe von der Wear-App (Phase 7.2, Data Layer). -->
        <service
            android:name="com.boulderbuddy.wearsync.HangboardWearListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/boulderbuddy/hangboard_completed" />
            </intent-filter>
        </service>
    </application>

</manifest>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.hardware.type.watch" />

    <!-- Haptisches Feedback bei Phasenwechsel/Ende des Hangboard-Timers. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Sensor-Aufzeichnung (B.5.1) als Foreground Service, sonst schläft die CPU beim Hängen.
         FGS-Typ health braucht zusätzlich eine der Sensor-Permissions — HIGH_SAMPLING_RATE_SENSORS
         ist install-time (kein Runtime-Dialog) und deckt die Anforderung ab. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- Kurzer Partial-Wakelock während der Aufzeichnung (Display aus, Arm ruhig). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Companion (kein Standalone): braucht das gekoppelte Phone für das Session-Tracking. -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <uses-library
            android:name="com.google.android.wearable"
            android:required="false" />

        <!-- Sensor-Aufzeichnung (B.5.1): läuft nur während einer Kalibrier-Session. -->
        <service
            android:name=".sensing.SensorLoggingService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <!-- Auto-Hang-Erkennung (M3): Sensorstrom → HangDetector, nur während der Session. -->
        <service
            android:name=".sensing.AutoHangService"
            android:exported="false"
            android:foregroundServiceType="health" />

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
